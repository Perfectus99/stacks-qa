# Base URL of the system under test.
# Deliberately off the common ports so the demo stack never collides with
# whatever else is running locally.
BASE_URL=http://localhost:3100

# Seeded admin used by the worker-scoped admin fixture.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin-password

# demo-api
PORT=3000
DATABASE_URL=postgres://stacks:stacks@localhost:5442/stacks
JWT_SECRET=development-only-secret
